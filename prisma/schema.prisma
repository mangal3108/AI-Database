// This is your Prisma schema file for Internite AI — Multi-Tenant SaaS Architecture
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector"), pg_trgm]
}

// ─────────────────────────────────────────────
// AUTH & MULTI-TENANCY HIERARCHY
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  auditLogs     AuditLog[]
  apiKeys       ApiKey[]
  visualizations Visualization[]
  scheduledReports ScheduledReport[]

  @@index([email])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  plan      OrgPlan   @default(FREE)
  logoUrl   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  memberships         Membership[]
  projects            Project[]
  databaseConnections DatabaseConnection[]
  conversations       Conversation[]
  savedQueries        SavedQuery[]
  knowledgeDocs       KnowledgeDocument[]
  dashboards          Dashboard[]
  auditLogs           AuditLog[]
  aiSettings          AiSettings?
  usageRecords        UsageRecord[]
  apiKeys             ApiKey[]
  subscriptions       Subscription[]
  payments            Payment[]
  invoices            Invoice[]
  billingCustomer     BillingCustomer?
  webhookEndpoints    WebhookEndpoint[]
  visualizations      Visualization[]
  dashboardWidgets    DashboardWidget[]
  scheduledReports    ScheduledReport[]

  @@map("organizations")
}

enum OrgPlan {
  FREE
  STARTER
  PRO
  TEAM
  BUSINESS
  ENTERPRISE
}

model Membership {
  id             String         @id @default(cuid())
  userId         String
  organizationId String
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("memberships")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// ─────────────────────────────────────────────
// PROJECTS (Sub-Tenant Scoping)
// ─────────────────────────────────────────────

model Project {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  databaseConnections DatabaseConnection[]
  conversations       Conversation[]
  savedQueries        SavedQuery[]
  knowledgeDocs       KnowledgeDocument[]
  dashboards          Dashboard[]
  auditLogs           AuditLog[]
  usageRecords        UsageRecord[]
  apiKeys             ApiKey[]

  @@unique([organizationId, slug])
  @@map("projects")
}

// ─────────────────────────────────────────────
// DATABASE CONNECTIONS (Tenant-Isolated)
// ─────────────────────────────────────────────

model DatabaseConnection {
  id                   String           @id @default(cuid())
  organizationId       String
  projectId            String?
  name                 String
  type                 DatabaseType
  encryptedCredentials String           @db.Text
  status               ConnectionStatus @default(PENDING)
  lastTestedAt         DateTime?
  lastErrorMessage     String?
  readOnly             Boolean          @default(true)
  sslEnabled           Boolean          @default(true)
  defaultSchema        String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  deletedAt            DateTime?

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project       Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  schemas       DbSchema[]
  conversations Conversation[]
  knowledgeDocs KnowledgeDocument[]
  queries       Query[]
  visualizations Visualization[]

  @@index([organizationId])
  @@index([organizationId, projectId])
  @@map("database_connections")
}

enum DatabaseType {
  POSTGRESQL
  MYSQL
  MARIADB
  SQLSERVER
  SQLITE
  MONGODB
  COCKROACHDB
  NEON
  SUPABASE
}

enum ConnectionStatus {
  PENDING
  CONNECTED
  DISCONNECTED
  ERROR
  INDEXING
}

model DbSchema {
  id                   String   @id @default(cuid())
  databaseConnectionId String
  name                 String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  connection DatabaseConnection @relation(fields: [databaseConnectionId], references: [id], onDelete: Cascade)
  tables     DbTable[]

  @@unique([databaseConnectionId, name])
  @@map("db_schemas")
}

model DbTable {
  id          String   @id @default(cuid())
  schemaId    String
  name        String
  rowCount    BigInt?
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schema  DbSchema   @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  columns DbColumn[]

  @@unique([schemaId, name])
  @@map("db_tables")
}

model DbColumn {
  id           String   @id @default(cuid())
  tableId      String
  name         String
  dataType     String
  isNullable   Boolean  @default(true)
  isPrimaryKey Boolean  @default(false)
  isForeignKey Boolean  @default(false)
  isUnique     Boolean  @default(false)
  isSensitive  Boolean  @default(false)
  description  String?  @db.Text
  sampleValues Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  table DbTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, name])
  @@map("db_columns")
}

// ─────────────────────────────────────────────
// CONVERSATIONS & CHAT HISTORY (Tenant Scoped)
// ─────────────────────────────────────────────

model Conversation {
  id                   String    @id @default(cuid())
  organizationId       String
  projectId            String?
  userId               String
  databaseConnectionId String?
  title                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  connection   DatabaseConnection? @relation(fields: [databaseConnectionId], references: [id], onDelete: SetNull)

  messages Message[]
  queries  Query[]

  @@index([organizationId, userId])
  @@index([organizationId, projectId])
  @@map("conversations")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String      @db.Text
  metadata       Json?
  tokensUsed     Int?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model SavedQuery {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  queryId        String?
  name           String
  description    String?  @db.Text
  rawQuery       String   @db.Text
  queryLanguage  String   @default("sql")
  chartConfig    Json?
  isPublic       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  query          Query?          @relation(fields: [queryId], references: [id], onDelete: SetNull)
  dashboardItems DashboardItem[]
  visualizations Visualization[]

  @@index([organizationId])
  @@map("saved_queries")
}

model Query {
  id                   String      @id @default(cuid())
  organizationId       String
  projectId            String?
  databaseConnectionId String
  conversationId       String?
  userId               String
  rawQuery             String      @db.Text
  queryLanguage        String      @default("sql")
  status               QueryStatus
  rowCount             Int?
  executionTimeMs      Int
  errorMessage         String?     @db.Text
  createdAt            DateTime    @default(now())

  connection   DatabaseConnection @relation(fields: [databaseConnectionId], references: [id], onDelete: Cascade)
  conversation Conversation?      @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  savedQueries SavedQuery[]

  @@index([organizationId, createdAt])
  @@index([databaseConnectionId])
  @@map("queries")
}

enum QueryStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  ERROR
  REJECTED
  REJECTED_SAFETY
  TIMEOUT
  TIMED_OUT
  CANCELLED
}

// ─────────────────────────────────────────────
// RAG KNOWLEDGE SYSTEM (Strict Tenant Isolation)
// ─────────────────────────────────────────────

model KnowledgeDocument {
  id                   String     @id @default(cuid())
  organizationId       String
  projectId            String?
  databaseConnectionId String?
  title                String
  sourceType           SourceType
  fileUrl              String?
  contentHash          String?
  status               DocStatus  @default(PENDING)
  chunkCount           Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  connection   DatabaseConnection? @relation(fields: [databaseConnectionId], references: [id], onDelete: SetNull)
  chunks       KnowledgeChunk[]

  @@index([organizationId])
  @@index([organizationId, projectId])
  @@map("knowledge_documents")
}

enum SourceType {
  SCHEMA_AUTO
  BUSINESS_GLOSSARY
  USER_DOCUMENT
  SAVED_QUERY
  MANUAL_ENTRY
}

enum DocStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

model KnowledgeChunk {
  id                   String                   @id @default(cuid())
  organizationId       String
  projectId            String?
  documentId           String
  databaseConnectionId String?
  content              String                   @db.Text
  embedding            Unsupported("vector")?
  metadata             Json?
  createdAt            DateTime                 @default(now())

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, projectId])
  @@index([documentId])
  @@map("knowledge_chunks")
}

// ─────────────────────────────────────────────
// DASHBOARDS & VISUALIZATIONS
// ─────────────────────────────────────────────

model Dashboard {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  name           String
  description    String?  @db.Text
  layout         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items        DashboardItem[]
  widgets      DashboardWidget[]
  scheduledReports ScheduledReport[]

  @@index([organizationId])
  @@map("dashboards")
}

model DashboardItem {
  id                 String            @id @default(cuid())
  dashboardId        String
  savedQueryId       String?
  title              String
  visualizationType  VisualizationType @default(TABLE)
  config             Json?
  gridPosition       Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  dashboard  Dashboard   @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  savedQuery SavedQuery? @relation(fields: [savedQueryId], references: [id], onDelete: SetNull)

  @@map("dashboard_items")
}

enum VisualizationType {
  BAR
  LINE
  PIE
  AREA
  SCATTER
  HISTOGRAM
  KPI
  TABLE
  HEATMAP
}

// ─────────────────────────────────────────────
// API KEYS, SETTINGS, AUDIT & USAGE (Tenant Scoped)
// ─────────────────────────────────────────────

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String?
  userId         String
  name           String
  keyHash        String    @unique
  keyPrefix      String
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_keys")
}

model AiSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  provider       String   @default("mistral")
  model          String   @default("mistral-small-latest")
  maxTokens      Int      @default(4096)
  temperature    Float    @default(0.1)
  maxRows        Int      @default(10000)
  readOnlyMode   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  userId         String?
  action         String
  resourceType   String?
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, projectId])
  @@map("audit_logs")
}

model UsageRecord {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  userId         String?
  metric         String
  value          Int
  period         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId, metric, period])
  @@index([organizationId, projectId])
  @@map("usage_records")
}

// ─────────────────────────────────────────────
// BILLING, SUBSCRIPTIONS, INVOICES & PAYMENTS (Multi-Tenant SaaS)
// ─────────────────────────────────────────────

model Plan {
  id               String   @id @default(cuid())
  name             String   @unique
  slug             String   @unique
  description      String?  @db.Text
  priceMonthly     Int
  priceYearly      Int
  currency         String   @default("USD")
  isActive         Boolean  @default(true)
  limits           Json
  // Provider-specific plan IDs
  stripePriceId    String?
  razorpayPlanIdMonthly  String?
  razorpayPlanIdYearly   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  entitlements  PlanEntitlement[]
  subscriptions Subscription[]

  @@map("plans")
}

model PlanEntitlement {
  id         String   @id @default(cuid())
  planId     String
  featureKey String
  value      String   @default("true")
  createdAt  DateTime @default(now())

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
  @@map("plan_entitlements")
}

model BillingCustomer {
  id                 String   @id @default(cuid())
  organizationId     String   @unique
  stripeCustomerId   String?  @unique
  razorpayCustomerId String?  @unique
  email              String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("billing_customers")
}

model Subscription {
  id                    String             @id @default(cuid())
  organizationId        String
  planId                String
  stripeSubscriptionId   String?           @unique
  razorpaySubscriptionId String?           @unique
  razorpayPlanId         String?
  status                SubscriptionStatus @default(ACTIVE)
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean            @default(false)
  canceledAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         Plan         @relation(fields: [planId], references: [id])
  invoices     Invoice[]

  @@index([organizationId])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  INCOMPLETE
  TRIALING
}

model Payment {
  id               String        @id @default(cuid())
  organizationId   String
  invoiceId        String?
  amount           Int
  currency         String        @default("USD")
  status           PaymentStatus @default(SUCCEEDED)
  paymentMethod    String?
  stripePaymentId  String?       @unique
  razorpayPaymentId String?      @unique
  razorpayOrderId   String?
  failureReason     String?
  createdAt        DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("payments")
}

enum PaymentStatus {
  SUCCEEDED
  FAILED
  PENDING
  REFUNDED
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  subscriptionId String?
  number         String        @unique
  amount         Int
  currency       String        @default("USD")
  status         InvoiceStatus @default(PAID)
  invoiceUrl     String?
  pdfUrl         String?
  createdAt      DateTime      @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  payments     Payment[]

  @@index([organizationId])
  @@map("invoices")
}

enum InvoiceStatus {
  PAID
  OPEN
  VOID
  UNCOLLECTIBLE
}

model WebhookEvent {
  id        String   @id @default(cuid())
  eventId   String   @unique
  type      String
  payload   Json
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("webhook_events")
}

model WebhookEndpoint {
  id             String   @id @default(cuid())
  organizationId String
  url            String
  secret         String
  events         Json
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("webhook_endpoints")
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("feature_flags")
}

// ─────────────────────────────────────────────
// PLATFORM ADMINISTRATION
// ─────────────────────────────────────────────

model PlatformAdmin {
  id        String   @id @default(cuid())
  userId    String   @unique
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("platform_admins")
}

// ─────────────────────────────────────────────
// DATA VISUALIZATION
// ─────────────────────────────────────────────

model Visualization {
  id             String   @id @default(cuid())
  organizationId String
  createdById   String
  databaseId     String
  queryId       String?

  name          String
  description   String?
  chartType    String   @default("BAR")

  // Chart configuration as JSON
  configuration Json    @default("{}")

  // Source query that generated the data
  sourceQuery   String?

  // Cached dataset hash for invalidation
  datasetHash   String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy       User                @relation(fields: [createdById], references: [id])
  database        DatabaseConnection  @relation(fields: [databaseId], references: [id], onDelete: Cascade)
  query           SavedQuery?         @relation(fields: [queryId], references: [id], onDelete: SetNull)
  dashboardWidgets DashboardWidget[]

  @@index([organizationId])
  @@index([databaseId])
  @@index([createdById])
  @@map("visualizations")
}

// Dashboard widget for embedding visualizations
model DashboardWidget {
  id              String   @id @default(cuid())
  dashboardId     String
  visualizationId String?
  organizationId  String

  type           String   @default("chart") // chart, kpi, table, ai_insight
  title          String?

  position       Json     @default("{\"x\":0,\"y\":0,\"w\":6,\"h\":4}")
  configuration  Json     @default("{}")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dashboard      Dashboard      @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  visualization  Visualization? @relation(fields: [visualizationId], references: [id], onDelete: SetNull)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@index([visualizationId])
  @@index([organizationId])
  @@map("dashboard_widgets")
}

// Scheduled reports for email delivery
model ScheduledReport {
  id             String   @id @default(cuid())
  organizationId String
  dashboardId    String
  createdById    String

  name               String
  description        String?

  // Schedule configuration
  scheduleType       ScheduleType @default(CUSTOM)
  cronExpression     String?
  frequency          ReportFrequency @default(WEEKLY)
  dayOfWeek         Int?        // 0-6 for weekly
  dayOfMonth         Int?        // 1-31 for monthly
  timeOfDay          String      @default("09:00") // HH:mm format

  // Recipients
  recipients         Json       @default("[]") // Array of email addresses

  // Output configuration
  format             ReportFormat @default(PDF)
  includeAIInsights  Boolean    @default(true)

  // Status
  isActive           Boolean    @default(true)
  lastRunAt          DateTime?
  nextRunAt          DateTime?
  runCount           Int        @default(0)
  failureCount       Int        @default(0)
  lastError          String?

  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  dashboard          Dashboard   @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy          User       @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([dashboardId])
  @@index([isActive])
  @@index([nextRunAt])
  @@map("scheduled_reports")
}

enum ScheduleType {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum ReportFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
}

enum ReportFormat {
  PDF
  CSV
  XLSX
}
